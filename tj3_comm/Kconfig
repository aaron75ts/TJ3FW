menuconfig TJ3_COMM
	bool "TJ3 communication modules"
	default y
	help
	  Communication helpers for TJ3 app: framing/protocol, BLE passthrough, and
	  UART link to nRF9151.

if TJ3_COMM

config TJ3_COMM_PROTOCOL
	bool "TJ3 framing/protocol"
	default y
	help
	  Enables frame encode/decode helpers used by BLE and UART links.

config TJ3_COMM_NRF9151_LINK
	bool "UART link to nRF9151"
	default y
	select UART_ASYNC_API
	help
	  Enables UART async transport for frames to/from nRF9151.

config TJ3_COMM_BLE
	bool "BLE GATT (write/notify)"
	default y
	depends on BT
	help
	  Exposes a simple GATT service with one RX (write) and one TX (notify)
	  characteristic.

config TJ3_COMM_MAX_PAYLOAD
	int "Max protocol payload (bytes)"
	default 244
	help
	  Maximum payload length accepted by the frame parser.

endif # TJ3_COMM
