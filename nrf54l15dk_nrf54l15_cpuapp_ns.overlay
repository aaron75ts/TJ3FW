            //         nordic,drive-mode = <NRF_DRIVE_H0H1>;
        //     };
    // };
    // pwm20_sleep: pwm20_sleep {
        //     group1 {
            //         psels = <NRF_PSEL(PWM_OUT0, 2, 0x9)>;
            //         low-power-enable;
        //     };
    // };

    // /* UART_DEBUG(Console, VCOM0, UART0)): TX=P0.00, RX=P0.01 */
    // uart30_default: uart30_default {
        //     group1 {
            //         psels = <NRF_PSEL(UART_TX, 0, 0)>;
        //     };

        //     group2 {
            //         psels = <NRF_PSEL(UART_RX, 0, 1)>;
            //         bias-pull-up;
        //     };
    // };
    // uart30_sleep: uart30_sleep {
        //     group1 {
            //         psels = <NRF_PSEL(UART_TX, 0, 0)>,
                               //                 <NRF_PSEL(UART_RX, 0, 1)>;
            //         low-power-enable;
        //     };
    // };

    // /* UART_NRP(nRF9151, VCOM1, UART1): TX=P1.05, RX=P1.04 */
    // uart20_default: uart20_default {
        //     group1 {
            //         psels = <NRF_PSEL(UART_TX, 1, 5)>;
        //     };

        //     group2 {
            //         psels = <NRF_PSEL(UART_RX, 1, 4)>;
            //         bias-pull-up;
        //     };
    // };
    // uart20_sleep: uart20_sleep {
        //     group1 {
            //         psels = <NRF_PSEL(UART_TX, 1, 5)>,
                               //                 <NRF_PSEL(UART_RX, 1, 4)>;
            //         low-power-enable;
        //     };
    // };

    /* UART_AT1(ATM90#1): P1.09, P1.10 */
    uart00_default: uart00_default {
        group1 {
            /* TX=P1.09 */
            psels = <NRF_PSEL(UART_TX, 1, 9)>;
        };

        group2 {
            /* RX=P1.10 */
            psels = <NRF_PSEL(UART_RX, 1, 10)>;
            bias-pull-up;
        };
    };
    uart00_sleep: uart00_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 9)>,
                    <NRF_PSEL(UART_RX, 1, 10)>;
            low-power-enable;
        };
    };

    /* UART_AT2(ATM90#2): P1.11, P1.12 */
    uart21_default: uart21_default {
        group1 {
            /* TX=P1.11 */
            psels = <NRF_PSEL(UART_TX, 1, 11)>;
        };

        group2 {
            /* RX=P1.12 */
            psels = <NRF_PSEL(UART_RX, 1, 12)>;
            bias-pull-up;
        };
    };
    uart21_sleep: uart21_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 11)>,
                    <NRF_PSEL(UART_RX, 1, 12)>;
            low-power-enable;
        };
    };

    /* UART_AT3(ATM90#3): P1.13, P1.14 */
    uart22_default: uart22_default {
        group1 {
            /* TX=P1.13 */
            psels = <NRF_PSEL(UART_TX, 1, 13)>;
        };

        group2 {
            /* RX=P1.14 */
            psels = <NRF_PSEL(UART_RX, 1, 14)>;
            bias-pull-up;
        };
    };
    uart22_sleep: uart22_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 13)>,
                    <NRF_PSEL(UART_RX, 1, 14)>;
            low-power-enable;
        };
    };

    /* SPI20
     * - SCK        = P2.01
     * - SIO0(MOSI) = P2.02
     * - SIO1(MISO) = P2.04
     * - SIO2       = P2.03
     * - SIO3       = P2.00
     * - CS         = P2.05
     */
    // spi20_default: spi20_default {
        //     group1 {
            //         psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
                               //                 <NRF_PSEL(SPIM_MOSI, 2, 2)>,
                               //                 <NRF_PSEL(SPIM_MISO, 2, 4)>;
        //     };
    // };
    // spi20_sleep: spi20_sleep {
        //     group1 {
            //         psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
                               //                 <NRF_PSEL(SPIM_MOSI, 2, 2)>,
                               //                 <NRF_PSEL(SPIM_MISO, 2, 4)>;
            //         low-power-enable;
        //     };
    // };
};

