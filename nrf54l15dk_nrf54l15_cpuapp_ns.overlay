/{
    buttons {
        compatible = "gpio-keys";
        #address-cells = <1>;
        #size-cells = <0>;

        bt1: bt1 {
            status = "okay";
            gpios = <&gpio1 0x2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        };
    };

    // /* PWM 輸出到 pwm20 的 P2.09 */
    // pwmleds {
        //     compatible = "pwm-leds";

        //     pwm_led1: pwm_led_1 {
            //         status = "okay";
            //         /* 使用 pwm20 的通道 0，週期 20ms */
            //         pwms = <&pwm20 0x0 0x01312d00 GPIO_ACTIVE_LOW>;
        //     };
    // };

    tj3_io: tj3_io {
        compatible = "tj3,io";

        di1.1-gpios = <&gpio2 0x6 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
        di2.1-gpios = <&gpio2 0x7 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;

        pulse-out-gpios = <&gpio2 0x8 (GPIO_ACTIVE_HIGH)>;
        poff-detect-gpios = <&gpio1 0x3 (GPIO_PULL_UP|GPIO_ACTIVE_HIGH)>;
        pw-reset-gpios = <&gpio1 0x8 (GPIO_ACTIVE_HIGH)>;
        nrp-reset-gpios = <&gpio2 0xa (GPIO_ACTIVE_HIGH)>;
    };

    chosen {
        zephyr,console = &uart30;
        zephyr,shell-uart = &uart30;
        zephyr,uart-mcumgr = &uart30;
        // nordic,pm-ext-flash = &ext_flash0;
    };

    aliases {
        uart-debug = &uart30; /* Console log, VCOM0 */
        uart-nrp   = &uart20; /* App log, VCOM1 */

        uart-at1 = &uart00; /* ATM90_1 */
        uart-at2 = &uart21; /* ATM90_2 */
        uart-at3 = &uart22; /* ATM90_3 */

        atm90e26-1 = &m90e26_1;
        atm90e26-2 = &m90e26_2;
        atm90e26-3 = &m90e26_3;

        // spi-flash = &spi20;
    };
};
