#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

&led0 {
    status = "okay";
};

&led1 {
    status = "disabled";
};
&led2 {
    status = "disabled";
};
&led3 {
    status = "disabled";
};

&button0 {
    status = "disabled";
};

&button1 {
    status = "disabled";
};

&button2 {
    status = "disabled";
};

&button3 {
    status = "disabled";
};

&pwm20 {
    status = "disabled";
};

&spi00 {
    status = "disabled";
};

&pinctrl {
    // pwm20_default: pwm20_default {
        //     group1 {
            //         /* 將 PWM 通道 0 (PWM_OUT0) 映射到 P2.09 ( led0 )*/
