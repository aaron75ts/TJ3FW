{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "nrf-connect",
            "request": "launch",
            "name": "Launch TJ3FW/build/TJ3FW",
            "config": "${workspaceFolder}/build/TJ3FW",
            "runToEntryPoint": "main"
        },
        {
            "name": "TJ3-GW: Run",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/docs/TJ3-GW/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/docs/TJ3-GW",
            "justMyCode": true
        },
        {
            "name": "TJ3-GW: Run (--debug)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/docs/TJ3-GW/main.py",
            "args": [
                "--debug"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/docs/TJ3-GW",
            "justMyCode": true
        },
        {
            "name": "TJ3-GW: Run (verbose BLE)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/docs/TJ3-GW/main.py",
            "args": [
                "--debug"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/docs/TJ3-GW",
            "justMyCode": false,
            "env": {
                "BLEAK_LOGGING": "1"
            }
        }
    ]
}